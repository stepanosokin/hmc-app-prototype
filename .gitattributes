# Measurement artifacts are byte-addressed by artifact-index.json.
# Preserve their exact recorded bytes across Windows/Linux checkouts.
docs/evidence/t3/** -text whitespace=cr-at-eol

# Shell execution and retained JSON hashes must survive Windows checkouts.
publication/** text eol=lf
tools/*.ps1 text eol=lf
requirements.publication.lock text eol=lf
docs/evidence/t4/** text eol=lf
docs/evidence/t5/** -text whitespace=cr-at-eol
docs/evidence/t6/** -text whitespace=cr-at-eol
docs/evidence/t7/** -text whitespace=cr-at-eol
docs/evidence/t8/** -text whitespace=cr-at-eol
# Raw service/transcript output retains the producer's whitespace verbatim.
docs/evidence/t8/*.log -whitespace

docs/evidence/t9/** -text whitespace=cr-at-eol
docs/evidence/t9/*.log -whitespace

docs/evidence/t10/** -text whitespace=cr-at-eol
docs/evidence/t10/*.log -whitespace

# This checker is byte-addressed in acceptance input inventories.
tools/check_evidence.py -text whitespace=cr-at-eol
