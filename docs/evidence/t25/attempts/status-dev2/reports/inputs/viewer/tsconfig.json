{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2023"], "strict": true, "allowJs": true,
    "checkJs": false, "outDir": "../data/viewer/build", "rootDir": ".",
    "noEmitOnError": true, "skipLibCheck": true
  },
  "include": ["*.ts", "*.js"], "exclude": ["test-*.mjs", "node_modules"]
}
